# Sample proxy (server) configuration.
# Use with: ./bin/yact -c <file> proxy

tls_config:
  # Directory containing ca.crt, server.crt and server.key. The value is used as-is,
  # so point it at the "server" directory created by make-certs.
  cert_dir: ./config/certs/server

# Address of the gRPC control port that clients connect to.
proxy_addr: ":8001"

keep_alive_interval: 1m
keep_alive_timeout: 5m
